<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtPesquisar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Pesquisar produto"
        android:inputType="text"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollCategorias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnAlimentos"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="ALIMENTOS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnDoces"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="DOCES"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnBebidas"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="BEBIDAS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnHigiene"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="HIGIENE"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnOutros"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="OUTROS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/vermelho_oferta"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- 📦 Resultados da Pesquisa (Sobrepõe os botões quando ativo) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPesquisa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/branco"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aviso quando a pesquisa não encontra nada -->
    <TextView
        android:id="@+id/txtSemResultados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Nenhum produto encontrado"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/azul_logo"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>