<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/branco"
    android:fitsSystemWindows="true"
    android:padding="16dp">

    <EditText
        android:id="@+id/edtPesquisar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Pesquisar produto"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnLimparBusca" />

    <ImageButton
        android:id="@+id/btnLimparBusca"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Limpar pesquisa"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:visibility="invisible"
        app:tint="@color/azul_logo"
        app:layout_constraintTop_toTopOf="@id/edtPesquisar"
        app:layout_constraintBottom_toBottomOf="@id/edtPesquisar"
        app:layout_constraintEnd_toEndOf="parent" />

    <ScrollView
        android:id="@+id/scrollCategorias"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnAlimentos"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="ALIMENTOS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnDoces"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="DOCES"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnBebidas"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="BEBIDAS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnHigiene"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="HIGIENE"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/azul_logo"
                android:layout_marginBottom="12dp"
                app:cornerRadius="12dp" />

            <Button
                android:id="@+id/btnOutros"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:text="OUTROS"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/branco"
                app:backgroundTint="@color/vermelho_oferta"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- 📦 Resultados da Pesquisa (Sobrepõe os botões quando ativo) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerPesquisa"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/branco"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Aviso quando a pesquisa não encontra nada -->
    <TextView
        android:id="@+id/txtSemResultados"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:gravity="center"
        android:text="Nenhum produto encontrado"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/azul_logo"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/edtPesquisar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ⏳ Primeira abertura: cobre a tela enquanto os produtos são cadastrados -->
    <LinearLayout
        android:id="@+id/painelCarregando"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/branco"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ProgressBar
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/azul_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Preparando os produtos..."
            android:textColor="@color/azul_logo"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Isso acontece só na primeira vez"
            android:textColor="@color/azul_logo"
            android:textSize="14sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>