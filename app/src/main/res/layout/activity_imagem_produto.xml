<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/visualizador_fundo">

    <!-- Uma página por produto; deslizar para os lados troca de produto -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/paginas"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topoVisualizador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/gradiente_topo"
        android:gravity="center_vertical"
        android:minHeight="64dp"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnFechar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Fechar"
            android:src="@drawable/ic_fechar"
            app:tint="@color/branco" />

        <TextView
            android:id="@+id/txtPosicao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/branco"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Setas visíveis: nem todo mundo sabe que dá para deslizar -->
    <ImageButton
        android:id="@+id/btnAnterior"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="8dp"
        android:background="@drawable/fundo_circulo_escuro"
        android:contentDescription="Produto anterior"
        android:src="@drawable/ic_anterior"
        app:tint="@color/branco" />

    <ImageButton
        android:id="@+id/btnProximo"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:background="@drawable/fundo_circulo_escuro"
        android:contentDescription="Próximo produto"
        android:src="@drawable/ic_proximo"
        app:tint="@color/branco" />

    <LinearLayout
        android:id="@+id/baseVisualizador"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/gradiente_base"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="56dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtCategoriaVisualizador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_pilula"
                android:drawablePadding="6dp"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/selo18Visualizador"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/fundo_selo_18"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="18+"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/txtNomeVisualizador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/branco"
            android:textSize="26sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditarVisualizador"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="Editar"
            android:textColor="@color/branco"
            android:textSize="16sp"
            app:backgroundTint="@color/branco_20"
            app:icon="@drawable/ic_editar"
            app:iconTint="@color/branco" />
    </LinearLayout>

</FrameLayout>
