<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <FrameLayout
        android:id="@+id/opcaoCirculo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/fundo_circulo_solido">

        <ImageView
            android:id="@+id/opcaoIcone"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="@color/branco" />
    </FrameLayout>

    <TextView
        android:id="@+id/opcaoNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:textColor="@color/texto_primario"
        android:textSize="17sp" />

    <TextView
        android:id="@+id/opcaoAtual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="atual"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp"
        android:visibility="gone" />

</LinearLayout>
