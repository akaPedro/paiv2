<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de categoria da tela inicial. Cor, ícone, nome e contagem vêm do código. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="128dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/azul_logo"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/branco_20">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Ícone grande e apagado no canto, como marca-d'água -->
        <ImageView
            android:id="@+id/tileMarcaDagua"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-20dp"
            android:layout_marginBottom="-22dp"
            android:importantForAccessibility="no"
            android:rotation="-12"
            app:tint="@color/branco_12" />

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="top|start"
            android:layout_margin="14dp"
            android:background="@drawable/fundo_circulo_translucido">

            <ImageView
                android:id="@+id/tileIcone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="@color/branco" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tileNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tileQuantidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/texto_sobre_cor"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</com.google.android.material.card.MaterialCardView>
