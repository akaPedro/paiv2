<?xml version="1.0" encoding="utf-8"?><!--
    Uma vitrine da tela inicial: título, atalho e as três vagas. Serve para
    promoção e para destaques; cor, ícone e textos vêm do código.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.Material3.CardView.Filled"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:rippleColor="@color/branco_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/vitIcone"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                app:tint="@color/branco" />

            <TextView
                android:id="@+id/vitTitulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/branco"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/fundo_pilula"
                android:backgroundTint="@color/branco_20"
                android:paddingStart="12dp"
                android:paddingTop="5dp"
                android:paddingEnd="12dp"
                android:paddingBottom="5dp"
                android:text="Escolher"
                android:textColor="@color/branco"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/vitVaga1"
                layout="@layout/item_produto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="3dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/vitVaga2"
                layout="@layout/item_produto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/vitVaga3"
                layout="@layout/item_produto"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1" />
        </LinearLayout>

        <TextView
            android:id="@+id/vitVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/texto_sobre_cor"
            android:textSize="15sp" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
